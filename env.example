# --- Commun ---
PORT=3333
API_KEY=un-secret-bien-choisi
# URL publique du serveur MCP (sans /mcp) — utilisée pour générer les liens dans l’admin (bouton URL MCP)
URL_PUBLIC=https://mon-domaine.com
# IPs séparées par des virgules, supporte le CIDR
ALLOWED_IPS=1.2.3.4,5.6.7.0/24,192.168.1.100

# Fichier JSON des connexions nommées (défaut : ./databases.json si le fichier existe)
# MCP_DATABASES_FILE=databases.json

# --- HFSQL (ODBC), type=hfsql (défaut) ---
HFSQL_DSN=DSN=ma_connexion_odbc

# --- MySQL, type=mysql ---
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=
# MYSQL_DATABASE=ma_base

# --- Microsoft SQL Server, type=mssql ---
# MSSQL_SERVER=127.0.0.1
# MSSQL_PORT=1433
# MSSQL_USER=sa
# MSSQL_PASSWORD=
# MSSQL_DATABASE=master
# MSSQL_ENCRYPT=true
# MSSQL_TRUST_SERVER_CERTIFICATE=true
